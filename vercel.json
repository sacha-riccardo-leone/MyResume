{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/CV-Sacha-Riccardo-Leone-(FR|EN|DE|IT)\\.pdf", "destination": "/Sacha-Leone-CV-$1.pdf", "permanent": true }
  ],
  "rewrites": [
    { "source": "/vnv", "destination": "/vnv/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
